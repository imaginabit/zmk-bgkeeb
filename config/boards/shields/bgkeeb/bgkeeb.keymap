#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Keymap de diagnóstico: cada posición escribe un símbolo único.
        // Pulsar switch físico → ver símbolo → identificar posición real.
        //
        // Posición (row,col):
        //   (0,0)=1 (0,1)=2 (0,2)=3 (0,3)=4 (0,4)=5
        //   (1,0)=6 (1,1)=7 (1,2)=8 (1,3)=9 (1,4)=0
        //   (2,0)=! (2,1)=@ (2,2)=# (2,3)=$ (2,4)=%
        //   (3,0)=^ (3,1)=& (3,2)=* (3,3)=( (3,4)=)
        //
        // Sin G/studio_unlock: si el problema es de mapeo, no atascar Studio.
        base {
            label = "Base";
            bindings = <
                &kp N1     &kp N2     &kp N3     &kp N4     &kp N5
                &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
                &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)
                &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)
            >;
        };
    };
};
