#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY (con desbloqueos para ZMK Studio).
        // G (row 1, col 4)              -> &studio_unlock (desbloqueo)
        // Combo Q+W (50ms)              -> &studio_unlock
        // Combo Q+W+E+R (80ms)          -> &studio_unlock (alternativa)
        base {
            label = "Base";
            bindings = <
                &kp Q         &kp W         &kp E         &kp R         &kp T
                &kp A         &kp S         &kp D         &kp F         &studio_unlock
                &kp Z         &kp X         &kp C         &kp V         &kp B
                              &none         &kp ENTER     &kp SPACE     &mo 1
            >;
        };

        // Layer 1: números y símbolos (mantener thumb derecho).
        num {
            label = "Num";
            bindings = <
                &kp N1        &kp N2        &kp N3        &kp N4        &kp N5
                &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
                &kp MINUS     &kp EQUAL     &kp BSLH      &kp GRAVE     &kp LBKT
                              &none         &kp ENTER     &kp SPACE     &kp LSHFT
            >;
        };

        // Combos de desbloqueo ZMK Studio.
        // Positions = flat array (parejas row,col).
        combos {
            compatible = "zmk,combos";
            combo_qw {
                timeout-ms = <50>;
                bindings = <&studio_unlock>;
                key-positions = <0 0 0 1>;
            };
            combo_qwer {
                timeout-ms = <80>;
                bindings = <&studio_unlock>;
                key-positions = <0 0 0 1 0 2 0 3>;
            };
        };
    };
};
