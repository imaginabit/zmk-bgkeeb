#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
//  Q  W  E  R  T       Y  U  I  O  P
//  A  S  D  F  G       H  J  K  L  ;
//  Z  X  C  V  B       N  M  ,  .  /
//  Tab Mo1 LCtl       LGui BSpc Mo2Space
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T
                &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G
                &kp H &kp J &kp K &kp L &kp SEMI
                &kp Z &kp X &kp C &kp V &kp B
                &kp N &kp M &kp COMMA &kp PERIOD &kp SLASH
                &kp TAB &mo 1 &kp LCTL
                &kp LGUI &kp BSPC &kp SPACE
            >;
        };

        lower {
// shifted nums / PgUp-Dn / arrows / [ ] / home caps lock
            bindings = <
                &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)
                &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)
                &kp PG_UP &kp PG_DN &kp END &kp ESC &kp DEL
                &kp LEFT &kp UP &kp DOWN &kp RIGHT &kp INS
                &kp LBKT &kp RBKT &kp LSFT(LBKT) &kp LSFT(RBKT) &kp SEMI
                &kp HOME &kp CAPS &kp BSPC &kp LSHFT &kp RALT
                &trans &trans &trans
                &trans &kp ENTER &kp ENTER
            >;
        };

        raise {
// shifted nums / [ ] | / { } / $ + - = \
            bindings = <
                &kp LSFT(N1) &kp LSFT(N2) &kp LSFT(N3) &kp LSFT(N4) &kp LSFT(N5)
                &kp LSFT(N6) &kp LSFT(N7) &kp LSFT(N8) &kp LSFT(N9) &kp LSFT(N0)
                &kp CAPS &kp RALT &kp BSLH &kp RBKT &kp HOME
                &kp HOME &kp END &kp UP &kp DOWN &kp DEL
                &kp LSFT(LBKT) &kp LSFT(RBKT) &kp LS(BSLH) &kp LS(TILDE) &kp UNDER
                &kp DQT &kp PLUS &kp MINUS &kp EQUAL &kp BSLH
                &trans &trans &trans
                &trans &kp SPACE &trans
            >;
        };

        adjust {
// F-keys F1 F2 F11 F12 BOOT   F6 F7 F8 F9 F10
// num lck ps slk  sysrst  arrows sysrst
// mo4  trans                            trans
            bindings = <
                &kp F1 &kp F2 &kp F11 &kp F12 &bootloader
                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &kp KP_NUM &kp PSCRN &kp SLCK &trans &sys_reset
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &sys_reset
                &mo 4 &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &trans &trans &trans
                &trans &trans &trans
            >;
        };

        numpad {
            bindings = <
                &bootloader &kp HOME &kp UP &kp END &trans
                &kp KP_DIVIDE &kp N7 &kp N8 &kp N9 &kp KP_PLUS
                &kp LEFT &kp DOWN &kp RIGHT &kp K_CUT &kp K_PASTE
                &kp KP_MULTIPLY &kp N4 &kp N5 &kp N6 &kp COMMA
                &kp K_COPY &kp K_PASTE &kp KP_NUM &trans &trans
                &kp KP_MINUS &kp N1 &kp N2 &kp N3 &kp EQUAL
                &trans &trans &trans
                &kp SPACE &kp BSPC &kp N0
            >;
        };

        combos {
            compatible = "zmk,combos";
            studio_unlock {
                timeout-ms = <80>;
                bindings = <&studio_unlock>;
                key-positions = <0 0 0 1 0 2 0 3>;
            };
        };
    };
};
