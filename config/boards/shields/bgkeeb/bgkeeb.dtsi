#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "bgkeeb default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        // Units in hundredths-of-u (1u = 100). Layout: 10 cols × 4 rows.
        // Cols 0-4 = left half, cols 5-9 = right half (gapless).
        keys  // width   height   x      y      r rx ry
            = <&key_physical_attrs 100 100    0     0    0  0  0>  /* RC(0,0) left half top-left */
            , <&key_physical_attrs 100 100  100     0    0  0  0>  /* RC(0,1) */
            , <&key_physical_attrs 100 100  200     0    0  0  0>  /* RC(0,2) */
            , <&key_physical_attrs 100 100  300     0    0  0  0>  /* RC(0,3) */
            , <&key_physical_attrs 100 100  400     0    0  0  0>  /* RC(0,4) */
            , <&key_physical_attrs 100 100  500     0    0  0  0>  /* RC(0,5) right half top-left */
            , <&key_physical_attrs 100 100  600     0    0  0  0>  /* RC(0,6) */
            , <&key_physical_attrs 100 100  700     0    0  0  0>  /* RC(0,7) */
            , <&key_physical_attrs 100 100  800     0    0  0  0>  /* RC(0,8) */
            , <&key_physical_attrs 100 100  900     0    0  0  0>  /* RC(0,9) right half top-right */
            , <&key_physical_attrs 100 100    0   100    0  0  0>  /* RC(1,0) */
            , <&key_physical_attrs 100 100  100   100    0  0  0>  /* RC(1,1) */
            , <&key_physical_attrs 100 100  200   100    0  0  0>  /* RC(1,2) */
            , <&key_physical_attrs 100 100  300   100    0  0  0>  /* RC(1,3) */
            , <&key_physical_attrs 100 100  400   100    0  0  0>  /* RC(1,4) */
            , <&key_physical_attrs 100 100  500   100    0  0  0>  /* RC(1,5) */
            , <&key_physical_attrs 100 100  600   100    0  0  0>  /* RC(1,6) */
            , <&key_physical_attrs 100 100  700   100    0  0  0>  /* RC(1,7) */
            , <&key_physical_attrs 100 100  800   100    0  0  0>  /* RC(1,8) */
            , <&key_physical_attrs 100 100  900   100    0  0  0>  /* RC(1,9) */
            , <&key_physical_attrs 100 100    0   200    0  0  0>  /* RC(2,0) */
            , <&key_physical_attrs 100 100  100   200    0  0  0>  /* RC(2,1) */
            , <&key_physical_attrs 100 100  200   200    0  0  0>  /* RC(2,2) */
            , <&key_physical_attrs 100 100  300   200    0  0  0>  /* RC(2,3) */
            , <&key_physical_attrs 100 100  400   200    0  0  0>  /* RC(2,4) */
            , <&key_physical_attrs 100 100  500   200    0  0  0>  /* RC(2,5) */
            , <&key_physical_attrs 100 100  600   200    0  0  0>  /* RC(2,6) */
            , <&key_physical_attrs 100 100  700   200    0  0  0>  /* RC(2,7) */
            , <&key_physical_attrs 100 100  800   200    0  0  0>  /* RC(2,8) */
            , <&key_physical_attrs 100 100  900   200    0  0  0>  /* RC(2,9) */
            , <&key_physical_attrs 100 100  200   350    0  0  0>  /* RC(3,2) left thumb inner */
            , <&key_physical_attrs 100 100  300   350    0  0  0>  /* RC(3,3) left thumb */
            , <&key_physical_attrs 100 100  400   350    0  0  0>  /* RC(3,4) left thumb outer */
            , <&key_physical_attrs 100 100  500   350    0  0  0>  /* RC(3,5) right thumb inner */
            , <&key_physical_attrs 100 100  600   350    0  0  0>  /* RC(3,6) right thumb */
            , <&key_physical_attrs 100 100  700   350    0  0  0>  /* RC(3,7) right thumb outer */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        // Identity transform: each physical position = keymap position.
        // Combined with col-offset=5 on the right half, the right half's
        // physical cols 0-4 map to keymap cols 5-9.
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        // Diode direction: matches the empirical behavior of the PCB.
        // The earlier session notes about "row2col" turned out to NOT be the
        // physical reality — flipping direction breaks all key detection.
        // cols = outputs driven HIGH, rows = inputs read with pull-down.
        // #define MATRIX_ROW_PINS { F6, D7, B3, E6 }     == { 19, 6, 14, 7 }
        // #define MATRIX_COL_PINS { F4, D4, F5, B1, B2 } == { 21, 4, 20, 15, 16 }
        row-gpios
            = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    // #define ENCODERS_PAD_A {B5} {9} {A9}
    // #define ENCODERS_PAD_B {B4} {8} {A8}

    // #define ENCODER_RESOLUTION 2 ------- used default zmk values instead
    encoder: encoder {
        compatible = "alps,ec11";
        label = "encoder";
        a-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
        // Encoder bindings via &kp directly (legacy / pre-sensor-bindings).
        // sensor-bindings property removed (not in current zmk,keymap-sensors yaml).
    };

    // Battery monitoring via nRF52840 internal VDDH voltage divider (no extra GPIO).
    // Solo con este nodo + &adc status "okay" (ya hecho por nice_nano base)
    // ZMK empieza a reportar battery % via Studio RPC.
    battery {
        compatible = "zmk,battery-nrf-vddh";
    };
};