#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY split layout (4 rows x 10 cols).
        // Left half: cols 0-4. Right half: cols 5-9 (mirrored typing row).
        // G typed normally; ZMK Studio unlock only via Q+W+E+R 4-key combo below.
        base {
            label = "Base";
            bindings = <
                &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         &kp U         &kp I         &kp O         &kp P
                &kp A         &kp S         &kp D         &kp F         &kp G         &kp SEMI     &kp L         &kp K         &kp J         &kp H
                &kp Z         &kp X         &kp C         &kp V         &kp B         &kp SLASH    &kp PERIOD   &kp COMMA    &kp M         &kp N
                              &kp ENTER     &kp SPACE     &mo 1         &mo 2         &kp BSPC      &kp TAB      &kp LSHFT
            >;
        };

        // Layer 1: números y símbolos.
        num {
            label = "Num";
            bindings = <
                &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
                &kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
                &kp MINUS    &kp EQUAL     &kp BSLH     &kp GRAVE    &kp LBKT     &kp RBKT     &kp Y        &kp U        &kp I        &kp O
                              &kp ENTER     &kp SPACE     &trans       &trans       &kp BSPC      &kp TAB      &kp LSHFT
            >;
        };

        // Único unlock: combo Q+W+E+R (4 teclas, RC(0,0)-(0,3) izquierda).
        // Hold ~80ms → desbloquea ZMK Studio. Sin tecla única ni Q+W.
        combos {
            compatible = "zmk,combos";
            combo_studio_unlock {
                timeout-ms = <80>;
                bindings = <&studio_unlock>;
                key-positions = <0 0 0 1 0 2 0 3>;
            };
        };
    };
};
